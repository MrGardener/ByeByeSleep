<?xml version="1.0" encoding="utf-8"?>
<!-- Screen saver settings: two switches, stored in the "screen_saver" prefs. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dream_settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="@string/dream_settings_title"
            android:textAppearance="?android:attr/textAppearanceLarge" />

        <Switch
            android:id="@+id/dream_night_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/dream_night_colours"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/dream_night_colours_summary"
            android:textAppearance="?android:attr/textAppearanceSmall" />

        <Switch
            android:id="@+id/dream_alarm_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/dream_show_alarm"
            android:textAppearance="?android:attr/textAppearanceMedium" />
    </LinearLayout>
</ScrollView>
