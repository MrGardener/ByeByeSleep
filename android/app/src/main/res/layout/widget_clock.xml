<?xml version="1.0" encoding="utf-8"?>
<!-- Clock widget: big self-updating time, the date, and the next alarm. RemoteViews-safe views only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/widget_padding">

    <TextClock
        android:id="@+id/clock_time"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:autoSizeMaxTextSize="112sp"
        android:autoSizeMinTextSize="28sp"
        android:autoSizeStepGranularity="2sp"
        android:autoSizeTextType="uniform"
        android:fontFamily="sans-serif-light"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/widget_text" />

    <TextClock
        android:id="@+id/clock_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:format12Hour="EEE, d MMMM"
        android:format24Hour="EEE, d MMMM"
        android:maxLines="1"
        android:textColor="@color/widget_text_secondary"
        android:textSize="15sp" />

    <LinearLayout
        android:id="@+id/clock_alarm_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_chip_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="12dp"
        android:paddingBottom="5dp">

        <ImageView
            android:id="@+id/clock_alarm_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@string/widget_alarm_icon"
            android:src="@drawable/ic_widget_alarm" />

        <TextView
            android:id="@+id/clock_alarm_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_preview_summary"
            android:textColor="@color/widget_text"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
